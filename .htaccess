# Apache / cPanel. Trên Nginx xem cấu hình tương đương trong README.

Options -Indexes
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

# Đường dẫn không đuôi .html: /san-pham -> san-pham.html, /admin/login -> admin/login.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Link cũ có .html chuyển hẳn sang bản không đuôi (index.html -> thư mục)
  RewriteCond %{THE_REQUEST} \s/+((?:[\w-]+/)*)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+((?:[\w-]+/)*[\w-]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  # /en -> /en/ để link tương đối trong trang tiếng Anh đúng thư mục
  RewriteRule ^en$ /en/ [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Chặn truy cập trực tiếp vào cấu hình, thư viện và tài liệu nội bộ
<FilesMatch "^(config\.php|README\.md|\.htaccess)$">
  Require all denied
</FilesMatch>
RedirectMatch 403 ^/(lib|docs|google-apps-script|_src|tools)(/|$)

# Kiểu file
AddType image/webp .webp
AddType video/webm .webm
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

# Nén
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json application/manifest+json text/xml application/xml
</IfModule>

# Bộ nhớ đệm trình duyệt
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Header bảo mật
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
